<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d1" for="edge" attr.name="bw" attr.type="double"/>
<key id="d0" for="edge" attr.name="capacity" attr.type="double"/>
<graph edgedefault="undirected"><node id="s1"/>
<node id="s2"/>
<node id="s3"/>
<node id="s4"/>
<edge source="s1" target="s2">
  <data key="d0">100.0</data>
  <data key="d1">100.0</data>
</edge>
<edge source="s1" target="s3">
  <data key="d0">100.0</data>
  <data key="d1">100.0</data>
</edge>
<edge source="s2" target="s4">
  <data key="d0">100.0</data>
  <data key="d1">100.0</data>
</edge>
<edge source="s3" target="s4">
  <data key="d0">100.0</data>
  <data key="d1">100.0</data>
</edge>
</graph></graphml>